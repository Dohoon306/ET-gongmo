# 복사해서 .env로 쓰세요 (cp .env.example .env). .env는 커밋되지 않습니다.
# docker compose와 백엔드가 같은 값을 읽습니다. 값을 안 바꾸면 기본값으로 동작합니다.

# PC에 MySQL이 이미 깔려 있어 3306이 겹치면 3307 등으로 바꾸세요
DB_PORT=3306
DB_NAME=et
DB_USERNAME=et
DB_PASSWORD=et1234
MYSQL_ROOT_PASSWORD=root

# AI 제공자가 정해지면 키를 넣습니다 (X-3). 비어 있으면 대체 응답으로 동작합니다
AI_API_KEY=
